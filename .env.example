# LeadPipe MCP configuration. Copy to .env and fill in, or export the
# variables in your MCP client's env block. Never commit a real .env.

# Demo mode: 1 runs the whole server against an in-memory fake client
# with a 12-lead sample dataset. No Google account needed. Start here.
LEADPIPE_DEMO=0

# Required outside demo mode: the ID of the Google Sheet that holds the
# pipeline (the long string in the Sheet URL). Create an empty Sheet,
# share it with your service account, and run: leadpipe bootstrap
LEADPIPE_SHEET_ID=

# Required outside demo mode: the calendar to check and book against.
# Use "primary" or a specific calendar ID from Google Calendar settings.
LEADPIPE_CALENDAR_ID=primary

# Required outside demo mode: path to YOUR Google service account key
# file (Google Cloud Console > IAM > Service Accounts > Keys). The file
# stays on your machine; LeadPipe reads it by path only and never logs,
# returns, or uploads its contents.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Write safety mode: direct, dry_run, or approval.
# Defaults: approval with real credentials, direct in demo mode.
# approval means every write is previewed first and only runs when the
# call is repeated with confirm=true. See docs/safety.md.
LEADPIPE_WRITE_MODE=approval

# Timezone for business hours and the daily summary (IANA name).
LEADPIPE_TIMEZONE=UTC

# Business hours used by check_availability, local to LEADPIPE_TIMEZONE,
# Monday to Friday.
LEADPIPE_BUSINESS_HOURS=09:00-17:00
